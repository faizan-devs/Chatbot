OPENAI_API_KEY=your_openai_api_key
AUTH_SECRET=change_this_to_a_long_random_secret
DATABASE_URL=postgresql://chatbot:chatbot_password@localhost:5432/chatbot
DATABASE_SSL=false
DAILY_MESSAGE_LIMIT=5
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional. If these are not set locally, reset tokens are printed in the backend terminal.
RESEND_API_KEY=
EMAIL_FROM=
